{
  "name": "servicehub-desktop",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.12.4",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0 --port 3000",
    "desktop": "pnpm build && electron .",
    "package:win": "pnpm build && electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^36.3.2",
    "electron-builder": "^26.0.12",
    "vite": "^6.3.5"
  },
  "build": {
    "appId": "com.servicehub.desktop",
    "productName": "Service Hub Desktop",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "artifactName": "ServiceHub-Desktop-${version}.exe"
    }
  }
}
