{
  "name": "servicehub-desktop",
  "version": "0.1.5",
  "private": true,
  "packageManager": "pnpm@10.12.4",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000",
    "build": "vite build",
    "test": "node --test",
    "preview": "vite preview --host 0.0.0.0 --port 3000",
    "desktop": "pnpm vite build --base=./ && electron .",
    "package:win": "pnpm vite build --base=./ && electron-builder --win nsis --publish never"
  },
  "devDependencies": {
    "electron": "^36.3.2",
    "electron-builder": "^26.0.12",
    "vite": "^6.3.5"
  },
  "build": {
    "appId": "com.servicehub.desktop",
    "productName": "Service Hub Desktop",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "artifactName": "ServiceHub-Desktop-${version}-Setup.exe"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Service Hub Desktop"
    }
  }
}
