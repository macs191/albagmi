# Server-only Vercel environment variables. Never expose the service-role key to Vite or Electron.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-publishable-or-anon-key
SUPABASE_SERVICE_ROLE_KEY=server-only-service-role-key
ALBAGMI_ADMIN_USERNAME=choose-admin-username
ALBAGMI_ADMIN_PASSWORD=choose-a-long-unique-password
ALBAGMI_ADMIN_JWT_SECRET=replace-with-a-random-secret-at-least-32-bytes
# Optional. Same-origin Vercel web requests need no CORS entry. For Electron file://, use * or an explicit origin.
ALBAGMI_ALLOWED_ORIGINS=*

# Public build-time value used by the portable Electron build; set it to the deployed Vercel URL before packaging.
VITE_API_BASE_URL=https://your-app.vercel.app
